# ============================================================================
# INTIME TECHNOLOGY - VARIÁVEIS DE AMBIENTE (PORTAINER / DOCKER / LOCAL)
# ============================================================================

# --- Banco de Dados PostgreSQL 16 ---
POSTGRES_USER=intime_admin
POSTGRES_PASSWORD=InTime@SecureDB2026!
POSTGRES_DB=intime_os_db
DATABASE_URL="postgresql://intime_admin:InTime@SecureDB2026!@localhost:5432/intime_os_db?schema=public"

# --- Segurança e Autenticação (JWT + Cookies HTTP-Only) ---
JWT_SECRET="intime-technology-jwt-secret-key-256bits-production-2026"

# --- Domínio Público / Cloudflare Tunnel (Usado pelo App Android e QR Codes) ---
NEXT_PUBLIC_APP_URL="https://os.intimetechnology.com.br"
CAPACITOR_SERVER_URL="https://os.intimetechnology.com.br"
TRUST_CLOUDFLARE_PROXY="true"

# --- Armazenamento Persistente (Mapeado nos Volumes do Docker/Portainer) ---
UPLOADS_DIR="/app/uploads"
BACKUPS_DIR="/app/backups"

# --- Conta Administrador Inicial (Criada no Seed) ---
INITIAL_ADMIN_EMAIL="admin@intimetechnology.com.br"
INITIAL_ADMIN_PASSWORD="InTime@Admin2026"
